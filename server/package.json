{
  "name": "interviewcheck-access-server",
  "version": "0.1.0",
  "private": true,
  "description": "Accounts, Stripe subscriptions, entitlements, and admin API for the InterviewCheck macOS app.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --disable-warning=ExperimentalWarning dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --disable-warning=ExperimentalWarning ./node_modules/vitest/vitest.mjs run",
    "test:watch": "node --disable-warning=ExperimentalWarning ./node_modules/vitest/vitest.mjs",
    "owner-license": "tsx src/tools/owner-license.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.9",
    "hono": "^4.13.19",
    "stripe": "^18.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^5.1.1"
  }
}
