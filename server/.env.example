# Copy to .env (or export in your shell) before `npm run dev`.

# HTTP
HOST=127.0.0.1
PORT=8787
# Public origin the browser can reach. Used for Stripe return pages.
PUBLIC_BASE_URL=http://localhost:8787

# Storage (SQLite file, created on first run)
DATABASE_PATH=./data/access.sqlite

# Admin claim: a signup becomes role=admin only when BOTH hold: the email is
# in this comma separated allow list AND the signup sends adminSecret equal
# to ADMIN_BOOTSTRAP_SECRET (the macOS sign in form has a field for it under
# Advanced). Rotate or clear the secret once your admin account exists, but
# only after TOTP_ENCRYPTION_KEY is set and the server has restarted once
# (see README, "Two factor seed encryption").
ADMIN_EMAILS=you@example.com
ADMIN_BOOTSTRAP_SECRET=

# Dedicated key for two factor seeds: 32 bytes, base64 (openssl rand -base64 32).
# When empty, seeds use a key derived from ADMIN_BOOTSTRAP_SECRET (the old
# behaviour) and the server logs a warning at startup.
TOTP_ENCRYPTION_KEY=
# Name stored with each seed so keys can rotate. Change it with the key.
TOTP_ENCRYPTION_KEY_ID=k1
# Previous keys that may still decrypt old seeds: kid:base64,kid:base64
TOTP_ENCRYPTION_RETIRED_KEYS=

# Set to true only behind a trusted reverse proxy (Fly, nginx) so the rate
# limiter keys on the proxy supplied client address instead of the socket.
TRUST_PROXY=false
# The single header that proxy sets: fly-client-ip (Fly) or x-forwarded-for
# (nginx and similar; the last hop is used). Other headers are ignored.
TRUSTED_PROXY_HEADER=fly-client-ip

# Stripe (leave empty to run without billing; checkout returns 503)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=

# Access policy
# Days of free trial granted on signup. 0 means users must pay to use the app.
TRIAL_DAYS=0
# Days a past_due subscription keeps access while Stripe retries the card.
PAST_DUE_GRACE_DAYS=3
# Days the desktop app may keep working offline on a cached entitlement.
OFFLINE_GRACE_DAYS=7
# Days a sign in token stays valid (sliding).
SESSION_TTL_DAYS=30

# Deep link scheme registered by the macOS app (CFBundleURLTypes).
APP_URL_SCHEME=InterviewCheck
